{
  "name": "@sonamu-kit/cli",
  "version": "0.2.0",
  "description": "Command-line interface for Sonamu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git",
    "directory": "modules/cli"
  },
  "bin": {
    "sonamu": "./bin/sonamu.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && oxlint src tests bin && oxfmt --check src tests bin *.json *.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@logtape/file": "catalog:",
    "@logtape/logtape": "catalog:",
    "@optique/clack": "catalog:",
    "@optique/core": "catalog:",
    "@optique/logtape": "catalog:",
    "@optique/run": "catalog:",
    "@optique/zod": "catalog:",
    "@sonamu-kit/hmr-runner": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sonamu": "workspace:^",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "sonamu": "^0.12.0"
  }
}
