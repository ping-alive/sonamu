{
  "name": "@sonamu-kit/websocket-redis-adapter",
  "version": "0.13.0",
  "description": "Redis presence store and cluster bus for Sonamu multi-node WebSocket delivery",
  "license": "MIT",
  "author": "CartaNova <dev@cartanova.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git",
    "directory": "modules/websocket-redis-adapter"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "prepack": "pnpm run build",
    "typecheck": "pnpm run check:type",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.tools.json && oxlint src tests && oxfmt --check src tests *.json *.ts",
    "check:type": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "check:format": "oxfmt src tests *.json *.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "redis": "catalog:",
    "sonamu": "workspace:*",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "redis": "catalog:",
    "sonamu": ">=0.12.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
