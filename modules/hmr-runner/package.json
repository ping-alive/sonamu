{
  "name": "@sonamu-kit/hmr-runner",
  "version": "0.3.0",
  "description": "Runner for applications that use hmr-hook (forked from hot-hook)",
  "keywords": [
    "hmr",
    "hmr-hook",
    "runner"
  ],
  "license": "MIT",
  "author": "CartaNova <dev@cartanova.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartanova-ai/sonamu.git"
  },
  "bin": "./bin/run.js",
  "files": [
    "build",
    "bin"
  ],
  "type": "module",
  "main": "build/bin/run.js",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "del-cli build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps src/bin/test.ts",
    "test": "c8 pnpm quick:test",
    "prepublishOnly": "pnpm lint && pnpm build"
  },
  "dependencies": {
    "@adonisjs/ace": "catalog:",
    "execa": "catalog:"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "catalog:",
    "@changesets/cli": "catalog:",
    "@japa/assert": "catalog:",
    "@japa/file-system": "catalog:",
    "@japa/runner": "catalog:",
    "@japa/snapshot": "catalog:",
    "@julr/tooling-configs": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "c8": "catalog:",
    "del-cli": "catalog:",
    "desm": "catalog:",
    "execa": "catalog:",
    "fs-extra": "catalog:",
    "p-event": "catalog:",
    "p-timeout": "catalog:",
    "supertest": "catalog:",
    "ts-node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:ts-node-compat"
  }
}
